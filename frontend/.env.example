MODAL_API_URL=https://YOUR-DEPLOYED-URL.modal.run
MODAL_PROXY_TOKEN=wk-YOUR-ID.ws-YOUR-SECRET
MODEL_ID=google/gemma-4-31B-it
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&uselibpqcompat=true
BETTER_AUTH_SECRET=replace-with-a-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:5173
# Production only: the same canonical HTTPS URL as BETTER_AUTH_URL.
ORIGIN=http://localhost:5173
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret

# GitHub App (repository connection, issues, and pull requests)
GITHUB_APP_ID=your-github-app-numeric-id
GITHUB_APP_CLIENT_ID=your-github-app-client-id
GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret
GITHUB_APP_SLUG=your-github-app-slug
# Use a quoted value with literal \n locally. In Aiven, store the full PEM as a secret.
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
