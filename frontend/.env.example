MODAL_API_URL=https://YOUR-DEPLOYED-URL.modal.run
MODAL_PROXY_TOKEN=wk-YOUR-ID.ws-YOUR-SECRET
MODEL_ID=google/gemma-4-31B-it
# Optional independent reviewer; unavailable until URL, key and model are configured.
REVIEWER_API_URL=
REVIEWER_API_KEY=
REVIEWER_MODEL=
REVIEWER_RETENTION_DISCLOSURE=
# Optional controlled verification; unavailable until deployed admission passes.
RUNNER_API_URL=
RUNNER_API_KEY=
# Server-owned JSON array: repositoryId/baseSha/checks with trusted black-box cases.
TRUSTED_CHECKS_JSON=
# Optional operator assertion; absent or invalid means unavailable.
REQUIRED_CHECK_MANIFEST_JSON=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&uselibpqcompat=true
BETTER_AUTH_SECRET=replace-with-a-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:5173
# Production only: the same canonical HTTPS URL as BETTER_AUTH_URL.
ORIGIN=http://localhost:5173
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_APP_CLIENT_ID=your-github-app-client-id
GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
YOUR-PRIVATE-KEY-HERE
-----END RSA PRIVATE KEY-----"
GITHUB_APP_SLUG=your-github-app-slug
