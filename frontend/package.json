{
	"name": "frontend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"auth:migrate": "npx auth@latest migrate --config ./src/lib/auth.ts",
		"auth:check": "npx auth@latest check --config ./src/lib/auth.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"better-auth": "^1.7.23",
		"pg": "^8.23.1",
		"typescript": "^6.0.3"
	}
}
